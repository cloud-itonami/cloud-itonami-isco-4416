;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README: ISCO 4416 (Personnel Clerks) is a Wave 0 (cognitive substrate)
;; occupation with no robotics gate -- the actor keeps personnel records.
;; The physical work that remains is the paper personnel file and the
;; onboarding kit: a personnel file placed into the locked cabinet drawer,
;; and the onboarding kit (badge, equipment, forms) delivered to a new
;; hire's desk across office floors whose covering varies.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-4416"
 :cases
 [{:id :personnel-file-to-cabinet
   :kind :manipulator
   :procedure "arm moves a bundle of personnel files from the desk into the locked cabinet's lower drawer"
   :params {:l1-m 0.45 :l2-m 0.40 :m1-kg 4.0 :m2-kg 2.5
            :from [0.45 0.25] :to [0.55 -0.30] :duration-s 2.0 :steps 500}
   :sweep {:param :payload-kg :values [0.5 1.5 3.0 5.0 8.0]}
   :quantity :peak-tau1-nm
   :limit {:max 50.0 :basis "estimate: continuous shoulder torque of a ~5 kg-payload collaborative arm"}
   :boundary {:lo 0.1 :hi 30.0}}
  {:id :onboarding-kit-delivery
   :kind :transport
   :procedure "delivery robot carries the onboarding kit from the personnel office to the new hire's desk"
   :params {:mass-kg 35.0 :payload-kg 8.0 :distance-m 60.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 45.0 :cog-height-m 0.55 :support-half-length-m 0.25}
   :sweep {:param :crr :values [0.01 0.02 0.04 0.06 0.09 0.11]}
   :quantity :cycle-time-s
   :limit {:max 70.0 :basis "estimate: one office leg budget; rolling-resistance range from hard floor to thick carpet is also an estimate"}
   :boundary {:lo 0.005 :hi 0.2}}]}
